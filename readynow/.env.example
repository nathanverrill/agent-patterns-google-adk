# ReadyNow! model configuration — copy to readynow/.env and fill in ONE section.
# `docker compose -f readynow/docker-compose.yml up -d --build` picks it up.

# ── Option A: any OpenAI-compatible endpoint ─────────────────────────────
# Works with OpenAI, Groq, Together, OpenRouter, Fireworks, DeepSeek, vLLM,
# an internal gateway — anything serving the OpenAI /v1 chat API.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

#   Groq          LLM_BASE_URL=https://api.groq.com/openai/v1
#                 LLM_MODEL=llama-3.3-70b-versatile
#   Together      LLM_BASE_URL=https://api.together.xyz/v1
#   OpenRouter    LLM_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1
#
#   Local (Ollama / LM Studio / vLLM on your machine — no key needed):
#                 LLM_BASE_URL=http://host.docker.internal:11434/v1
#                 LLM_MODEL=llama3.1:8b
#   The model must support tool calling; ReadyNow! delegates through tools.

# ── Option B: Gemini (the original path) ─────────────────────────────────
# Comment out Option A and set just this. Key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini/gemini-2.5-flash

# ── Optional ─────────────────────────────────────────────────────────────
# GOOGLE_API_KEY=            # Google Maps geocoding; without it, Nominatim
# READYNOW_CONTACT=you@example.com   # User-Agent identity for NWS/Nominatim
# LLM_WARMUP=false           # skip the 1-token call at boot (first query is then slow)
# LITELLM_NUM_RETRIES=3
